# Weiwu X1 WiFi Board Configuration
# Based on ESP32-S3 with 8MB Flash, 8MB PSRAM

# Flash configuration
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# CPU Frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM Configuration
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# WiFi optimization for low memory
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# Cache configuration
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Wake word model (using default)
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

# System stack size
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# USB configuration
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# Partition table - use v2 8MB layout
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/8m.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/v2/8m.csv"

# Board specific
CONFIG_BOARD_TYPE_WEIWU_X1_WIFI=y

# Disable display (no OLED on this board)
# CONFIG_DISPLAY_ENABLED=n

# Audio settings
CONFIG_AUDIO_INPUT_SAMPLE_RATE=16000
CONFIG_AUDIO_OUTPUT_SAMPLE_RATE=24000

# OTA version URL
CONFIG_OTA_VERSION_URL="https://api.tenclass.net/xiaozhi/ota/"

# Language
CONFIG_LANGUAGE_ZH_CN=y

# Connection type - WebSocket (more stable for simple boards)
CONFIG_CONNECTION_TYPE_WEBSOCKET=y
# CONFIG_CONNECTION_TYPE_MQTT_UDP is not set

# Disable wake word detection to save memory (optional, can enable if needed)
# CONFIG_USE_WAKE_WORD_DETECT=n

# Reduce memory usage
CONFIG_FREERTOS_UNICORE=n

# Logging level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Disable some features to save flash space
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Audio codec - No codec (using I2S directly)
CONFIG_CODEC_I2S_BACKWARD_COMPATIBLE=n
